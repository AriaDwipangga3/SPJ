{
  "appId": "id.instansi.spj",
  "appName": "Sistem SPJ",
  "webDir": "dist",
  "server": {
    "androidScheme": "http",
    "cleartext": true
  },
  "android": {
    "allowMixedContent": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#f8fafc",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    }
  }
}